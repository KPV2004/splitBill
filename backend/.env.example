# Template for local configuration — this file IS committed to git.
# Copy it to `.env` and put real values there. NEVER put real secrets in this file.
# Configuration lives here, NOT in code (AI_NOTES.md §1.1 #2).

APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# Database — credentials live ONLY in .env, never in code or docker-compose defaults.
# POSTGRES_HOST stays `localhost` for local runs; the app container overrides it to `db`.
POSTGRES_USER=splitbill
POSTGRES_PASSWORD=change_me
POSTGRES_DB=splitbill
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ORIGINS=http://localhost:5173

# Sessions: 7 days; set SESSION_COOKIE_SECURE=true when served over HTTPS.
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false

# Password for the demo accounts created by `make seed` (alice, bob, carol, dave).
# Local demo only — choose your own; leave unset if you don't seed.
SEED_DEMO_PASSWORD=
