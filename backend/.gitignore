# --- Environment files (SECURITY_RULES.md §3.6) ---
# Protect ALL local env files — never commit these:
.env
.env.*
# ...but the template IS meant to be committed:
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# --- Tooling / OS ---
.DS_Store
.idea/
.vscode/
